@startuml
skinparam linetype ortho

class Usuario {
  - email : String
  - senha : String
}
class InstituicaoEnsino {
  - id : Long
  - nome : String
}

class Professor {
  - nome : String
  - cpf : String
  - departamento : String
  - saldo : int
  + creditarSemestre() : void
  + enviarMoedas(aluno : Aluno, valor : int, motivo : String) : EnvioMoeda
  + possuiSaldo(valor : int) : boolean
}

class Aluno {
  - nome : String
  - email : String
  - cpf : String
  - rg : String
  - endereco : String
  - curso : String
  - saldo : int
  + receberMoedas(valor : int) : void
  + debitar(valor : int) : void
  + consultarVantagens() : List<Vantagem>
  + trocarMoedas(vantagem : Vantagem) : TrocaVantagem
}

class EmpresaParceira {
  - nome : String
  - email : String
  + cadastrarVantagem(v : Vantagem) : void
}

class Vantagem {
  - id : Long
  - nome : String
  - descricao : String
  - foto : String
  - custoMoedas : int
}

abstract class Transacao {
  - id : Long
  - data : LocalDateTime
  - valor : int
}

class EnvioMoeda {
  - mensagem : String
}

class TrocaVantagem {
}

class Cupom {
  - codigo : String
  - dataEmissao : LocalDateTime
}

interface ServicoEmail {
  + enviar(destinatario : String, assunto : String, corpo : String) : void
}

class NotificacaoEmail {
  + notificarRecebimentoMoedas(envio : EnvioMoeda) : void
  + enviarCupomAoAluno(troca : TrocaVantagem) : void
  + enviarConferenciaAoParceiro(troca : TrocaVantagem) : void
}

Usuario <.. Aluno
Usuario <.. Professor
Usuario <.. EmpresaParceira

InstituicaoEnsino "1" o-- "0..*" Professor : vinculado a
InstituicaoEnsino "1" o-- "0..*" Aluno : estuda em

EmpresaParceira "1" *-- "1..*" Vantagem : oferece

Transacao <|-- EnvioMoeda
Transacao <|-- TrocaVantagem

Professor "1" --> "0..*" EnvioMoeda : realiza
Aluno "1" --> "0..*" EnvioMoeda : recebe

Aluno "1" --> "0..*" TrocaVantagem : realiza
Vantagem "1" <-- "0..*" TrocaVantagem : resgatada em
TrocaVantagem "1" *-- "1" Cupom : gera

ServicoEmail <|.. NotificacaoEmail
NotificacaoEmail ..> EnvioMoeda
NotificacaoEmail ..> TrocaVantagem
@enduml