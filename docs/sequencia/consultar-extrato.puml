@startuml consultar-extrato
skinparam shadowing false
skinparam defaultFontName Helvetica
hide footbox

title Diagrama de Sequência - Consultar extrato

actor "Usuário" as usuario
participant "Extrato.jsx" as tela
participant "api.js\n(extratoApi)" as api
participant "TransacaoController" as controller
participant "TransacaoService" as service
participant "AlunoRepository" as alunos
participant "ProfessorRepository" as professores
participant "TransacaoRepository" as transacoes
database "SQLite" as banco

note over usuario, tela
  A tela já carregou as listas de alunos e
  professores usadas nos campos de seleção.
end note

usuario -> tela : escolhe o perfil e o usuário
activate tela

alt perfil = aluno
  tela -> api : extratoApi.aluno(id)
  activate api
  api -> controller : GET /api/transacoes/extrato/aluno/{id}
  activate controller
  controller -> service : extrato_aluno(id)
  activate service
  service -> alunos : buscar_por_id(id)
  activate alunos
  alunos -> banco : SELECT em alunos
  activate banco
  banco --> alunos : registro ou vazio
  deactivate banco
  alunos --> service : aluno ou None
  deactivate alunos

  alt aluno encontrado
    service -> transacoes : listar_por_aluno(id)
    activate transacoes
    transacoes -> banco : SELECT em transacoes,\nenvios_moeda e trocas_vantagem\n(mais recentes primeiro)
    activate banco
    banco --> transacoes : registros
    deactivate banco
    transacoes --> service : envios e trocas do aluno
    deactivate transacoes
    service --> controller : saldo e transações
    controller --> api : 200 OK (saldo, transacoes)
    api --> tela : dados do extrato
    tela --> usuario : exibe o saldo e as transações
  else aluno não encontrado
    service --> controller : NaoEncontrado("Aluno não encontrado")
    deactivate service
    controller --> api : 404 Not Found (erro)
    deactivate controller
    api --> tela : ErroApi
    deactivate api
    tela --> usuario : exibe a mensagem de erro
  end

else perfil = professor
  tela -> api : extratoApi.professor(id)
  activate api
  api -> controller : GET /api/transacoes/extrato/professor/{id}
  activate controller
  controller -> service : extrato_professor(id)
  activate service
  service -> professores : buscar_por_id(id)
  activate professores
  professores -> banco : SELECT em professores
  activate banco
  banco --> professores : registro ou vazio
  deactivate banco
  professores --> service : professor ou None
  deactivate professores

  alt professor encontrado
    service -> transacoes : listar_por_professor(id)
    activate transacoes
    transacoes -> banco : SELECT em transacoes e envios_moeda\n(mais recentes primeiro)
    activate banco
    banco --> transacoes : registros
    deactivate banco
    transacoes --> service : envios do professor
    deactivate transacoes
    service --> controller : saldo e transações
    controller --> api : 200 OK (saldo, transacoes)
    api --> tela : dados do extrato
    tela --> usuario : exibe o saldo e as transações
  else professor não encontrado
    service --> controller : NaoEncontrado("Professor não encontrado")
    deactivate service
    controller --> api : 404 Not Found (erro)
    deactivate controller
    api --> tela : ErroApi
    deactivate api
    tela --> usuario : exibe a mensagem de erro
  end
end

deactivate tela

@enduml
